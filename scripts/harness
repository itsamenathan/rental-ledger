#!/usr/bin/env bash
# Test harness for agents working in a git worktree. See server/harness.ts.
#   scripts/harness setup   install dependencies and seed ./data with fictional data + logins
#   scripts/harness reset   wipe ./data and seed it again (stop the dev server first)
#   scripts/harness dev     run `vp dev` on this worktree's own port, listening on all interfaces
#   scripts/harness preview build and run the production server on that port (service worker / offline mode)
#   scripts/harness info    print data/harness.json (logins, API keys, URL)
set -euo pipefail
cd "$(dirname "$0")/.."

# Actions launched by T3 Code may not get the login shell's PATH.
command -v vp >/dev/null || export PATH="$HOME/.local/share/vite-plus/bin:$HOME/.vite-plus/bin:$PATH"
command -v vp >/dev/null || { echo "vp (Vite+) not found on PATH" >&2; exit 127; }

node_version="$(tr -d '[:space:]' < .node-version)"
with_node() { vp env exec --node "$node_version" "$@"; }
seed() { LOG_LEVEL="${LOG_LEVEL:-warn}" with_node node server/harness.ts "$@"; }

case "${1:-}" in
  setup)
    vp install
    seed reset
    ;;
  reset)
    seed reset
    ;;
  dev)
    [ -f data/harness.json ] || seed reset
    port="$(seed port)"
    exec vp env exec --node "$node_version" vp dev --host 0.0.0.0 --port "$port" --strictPort
    ;;
  preview)
    [ -f data/harness.json ] || seed reset
    port="$(seed port)"
    with_node vp build
    PORT="$port" LOG_LEVEL="${LOG_LEVEL:-warn}" exec vp env exec --node "$node_version" node server/main.ts
    ;;
  info)
    cat data/harness.json
    ;;
  *)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
